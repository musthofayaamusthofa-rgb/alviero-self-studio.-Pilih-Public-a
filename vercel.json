{
  "rewrites": [
    {
      "source": "/adminsalto",
      "destination": "/adminsalto/index.html"
    },
    {
      "source": "/adminsalto/:match*",
      "destination": "/adminsalto/index.html"
    },
    {
      "source": "/((?!api|adminsalto|images|data|assets|fonts|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
